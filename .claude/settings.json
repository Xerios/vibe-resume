{
	"extraKnownMarketplaces": {
		"svelte": {
			"source": {
				"source": "github",
				"repo": "sveltejs/ai-tools"
			}
		}
	},
	"enabledPlugins": {
		"svelte@svelte": true
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-destructive.sh"
					}
				]
			}
		]
	},
	"sandbox": {
		"enabled": true,
		"filesystem": {
			"allowRead": [
				"."
			],
			"denyRead": [
				"~/.ssh",
				"~/.aws",
				"**/.env"
			],
			"allowWrite": [
				"~/.npm",
				"~/.cache"
			]
		},
		"network": {
			"allowedDomains": [
				"registry.npmjs.org",
				"api.github.com"
			]
		},
		"autoAllowBashIfSandboxed": true
	},
	"includeCoAuthoredBy": false,
	"gitAttribution": false
}