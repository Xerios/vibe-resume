{
	"permissions": {
		"allow": [
			"Bash(pnpm i *)"
		],
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(**/.env)",
			"Read(./.svelte-kit/**)",
			"Read(./.vite-hooks/**)",
			"Read(./content/**)",
			"Read(./node_modules/**)",
			"Read(./dist/**)",
			"Read(./secrets/**)",
			"Read(./config/credentials.json)",
			"Read(~/.ssh/**)",
			"Read(.git/**)",
			"Bash(rm -rf node_modules*)",
			"Bash(rm -rf *)",
			"Bash(rm:*)",
			"Bash(sudo:*)",
			"Bash(chmod 777:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git reset --hard:*)",
			"Bash(git clean:*)",
			"Bash(git restore:*)",
			"Bash(dd:*)",
			"Bash(mkfs:*)",
			"Bash(* > /dev/sda*)"
		]
	},
	"extraKnownMarketplaces": {
		"svelte": {
			"source": {
				"source": "github",
				"repo": "sveltejs/ai-tools"
			}
		}
	},
	"enabledPlugins": {
		"svelte@svelte": true
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-destructive.sh"
					}
				]
			}
		]
	},
	"sandbox": {
		"enabled": true,
		"filesystem": {
			"allowRead": [
				"."
			],
			"denyRead": [
				"~/.ssh",
				"~/.aws",
				"**/.env"
			],
			"allowWrite": [
				"~/.npm",
				"~/.cache"
			]
		},
		"network": {
			"allowedDomains": [
				"registry.npmjs.org",
				"api.github.com"
			]
		},
		"autoAllowBashIfSandboxed": true
	},
	"includeCoAuthoredBy": false,
	"gitAttribution": false
}