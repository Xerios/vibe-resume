{
  "name": "vibe-resume",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @vibe-resume/web dev",
    "build": "pnpm --filter @vibe-resume/web build",
    "preview": "pnpm --filter @vibe-resume/web preview",
    "check": "pnpm check:types && pnpm check:lint && pnpm check:tests",
    "check:types": "pnpm -r --workspace-concurrency=1 run check:types",
    "check:lint": "oxlint --deny-warnings",
    "check:tests": "vitest run",
    "check:fmt": "oxfmt --check",
    "test": "vitest",
    "lint": "oxlint --fix",
    "fmt": "oxfmt"
  },
  "devDependencies": {
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.83.0",
    "svelte": "catalog:",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{svelte,json,jsonc,css,scss,md,yml,yaml,html}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
