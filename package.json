{
  "name": "ai-resume",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm check:types && pnpm check:lint && pnpm check:tests",
    "check:types": "svelte-check --tsconfig ./tsconfig.json",
    "check:lint": "oxlint --deny-warnings",
    "check:tests": "vitest run",
    "check:fmt": "oxfmt --check",
    "test": "vitest",
    "lint": "oxlint --fix",
    "fmt": "oxfmt"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "codemirror-wrapped-line-indent": "^1.0.9",
    "lint-staged": "^16.4.0",
    "loro-codemirror": "^0.3.3",
    "loro-crdt": "^1.16.1",
    "marked": "^18.0.13",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.83.0"
  },
  "devDependencies": {
    "@iconify-icons/lucide": "^2.0.8",
    "@iconify/svelte": "^5.2.2",
    "@radix-ui/colors": "^3.0.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "sass": "^1.104.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{svelte,json,jsonc,css,scss,md,yml,yaml,html}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
